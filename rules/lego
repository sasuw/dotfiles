#!/bin/bash

# Enable parts/lego when the lego that LEGO_VERSION (common/zsh/.zshvars, read
# without sourcing it) names is installed. The rule sources the PATH snippet
# itself, so the rule and the PATH entry always pick the same directory; a
# newer /opt/lego_v* install (staging) is ignored until LEGO_VERSION changes.
# shellcheck source=common/bin/.bin/lib/rule_context.sh
source "${BASH_SOURCE[0]%/*}/../common/bin/.bin/lib/rule_context.sh" || exit 1
dotfiles_rule_context "${BASH_SOURCE[0]%/*}/.." || exit 1
dotfiles_rule_pin LEGO_VERSION || exit 1
source "${DOTFILE_DIR}/parts/lego/path/.shellinclude/path_lego.sh" || exit 1

if [[ -n "${LEGO_DIR:-}" && -x "${LEGO_DIR}/lego" ]]; then
  export LEGO_DIR
  exit 0
else
  exit 1
fi
